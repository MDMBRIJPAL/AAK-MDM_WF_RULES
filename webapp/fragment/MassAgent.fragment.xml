<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="id_massagent" class="cl_DialogStyle sapUiSizeCompact sapUiSmallMargin" contentWidth="380px">
		<customHeader>
			<Toolbar class="cl_DilogCustomHdr" height="2.5rem">
				<ToolbarSpacer/>
				<Text text="{i18n>MAC}" class="cl_DialogTitle sapUiTinyMarginTopBottom"/>
				<ToolbarSpacer/>
			</Toolbar>
		</customHeader>
		<VBox class="sapUiTinyMargin">
			<RadioButtonGroup id="ID_MassAgent" select="onMassAgentOptionSelect" columns="3" class="cl_wfradiobtns sapUiTinyMarginBegin">
				<RadioButton text="{i18n>ApplicationWise}"/>
				<RadioButton text="{i18n>MasterWise}"/>
				<RadioButton text="{i18n>Overall}"/>
			</RadioButtonGroup>
			<VBox id="dynamicAgentBox" class="sapUiSmallMarginTop"></VBox>
		</VBox>
		<buttons>
			<Button text="{i18n>Cancel}" class="cl_SecondaryButton sapUiTinyMarginEnd" icon="{= ${JM_ImageModel>/path} + 'Cancel.svg' }"
				press="fn_massAgentCancel"/>
			<Button text="{i18n>Ok}" press="fn_massAgentChange" icon="{= ${JM_ImageModel>/path} + 'Apply.svg' }" class="cl_PrimaryButton "/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>