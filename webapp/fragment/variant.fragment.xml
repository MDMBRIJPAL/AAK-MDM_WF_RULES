<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:grid="sap.ui.layout">
	<Dialog id="idvariantOpen" class="cl_DialogStyle sapUiSizeCompact " stretch="false" horizontalScrolling="false" verticalScrolling="true"
		contentWidth="50rem">
		<customHeader>
			<Toolbar class="cl_DilogCustomHdr" height="2.5rem">
				<ToolbarSpacer/>
				<Text text="{i18n>Variant}" class="cl_DialogTitle sapUiTinyMarginTopBottom"/>
				<ToolbarSpacer/>
			</Toolbar>
		</customHeader>
		<VBox id="ID_CREATE_VAR" class=" sapUiSmallMarginBeginEnd" height="100%">
			<HBox id="ID_CREATE_VAR_HBOX" visible="false" class="sapUiSmallMarginBeginEnd sapUiSmallMarginTopBottom">
				<Text id="ID_VAR_TEXT" class="cl_varText"/>
			</HBox>
			<HBox>
				<grid:Grid hSpacing="1" defaultSpan="L12 M12 S12">
					<VBox class="sapUiSmallMarginTop">
						<t:Table id="idVariantTable" rows="{WFViewModel>/variants}" selectionMode="Single" selectionBehavior="Row" visibleRowCount="9"
							enableSelectAll="false" class=" sapUiSmallMarginBottom cl_TableStyle" columnHeaderHeight="25" rowHeight="32"
							rowSelectionChange=".onVariantRowSelection1">
							<t:noData>
								<VBox alignItems="Center" justifyContent="Center">
									<Image src="{= ${JM_ImageModel>/path} + 'Nodatafound.gif'}" width="150px" height="150px"/>
									<!--<Image src="{= ${JM_ImageModel>/path} + 'NoDataFound.png'}" width="150px" height="150px"/>-->
									<Text text="{i18n>NoDataFound}"/>
								</VBox>
							</t:noData>
							<t:columns>
								<t:Column>
									<t:label>
										<Label text="{i18n>Variants}"/>
									</t:label>
									<t:template>
										<Text text="{WFViewModel>Variant}" class=" sapUiTinyMarginBegin cl_TableLabel"/>
									</t:template>
								</t:Column>
							</t:columns>
						</t:Table>
						<layoutData>
							<grid:GridData span="L4 M12 S12"/>
						</layoutData>
					</VBox>
					<VBox class="sapUiSmallMarginTop">
						<t:Table id="idVariantsTable" rows="{WFViewModel>/views}" selectionMode="None" selectionBehavior="RowSelector" visibleRowCount="9"
							enableSelectAll="true" class="sapUiSmallMarginBottom cl_TableStyle ">
							<t:noData>
								<VBox alignItems="Center" justifyContent="Center">
									<Image src="{= ${JM_ImageModel>/path} + 'Nodatafound.gif'}" width="150px" height="150px"/>
									<!--<Image src="{= ${JM_ImageModel>/path} + 'NoDataFound.png'}" width="150px" height="150px"/>-->
									<Text text="{i18n>NoDataFound}"/>
								</VBox>
							</t:noData>
							<t:columns>
								<t:Column width="22%">
									<t:label>
										<Label text="{i18n>SelectView}" tooltip="{i18n>SelectView}"/>
									</t:label>
									<t:template>
										<CheckBox selected="{WFViewModel>Active}" select=".onSelectCheckbox" enabled="false" class="sapUiTinyMarginBegin cl_checkbx"/>
									</t:template>
								</t:Column>
								<t:Column width="20%">
									<t:label>
										<Label text="{i18n>ReadOnly}"/>
									</t:label>
									<t:template>
										<CheckBox selected="{WFViewModel>ReadOnly}" enabled="false" class="sapUiTinyMarginBegin cl_checkbx"/>
									</t:template>
								</t:Column>
								<t:Column>
									<t:label>
										<Label text="{i18n>ViewName}"/>
									</t:label>
									<t:template>
										<Text text="{WFViewModel>ViewName}" class="sapUiTinyMarginBegin cl_TableLabel"/>
									</t:template>
								</t:Column>
							</t:columns>
						</t:Table>
						<layoutData>
							<grid:GridData span="L8 M12 S12"/>
						</layoutData>
					</VBox>
				</grid:Grid>
			</HBox>
		</VBox>
		<buttons>
			<Button text="{i18n>Close}" icon="{= ${JM_ImageModel>/path} + 'cancel.svg'}" class="cl_SecondaryButton sapUiSizeCompact sapUiTinyMarginEnd"
				press="onCancelSelectVar"/>
			<Button text="{i18n>Submit}" class="cl_PrimaryButton sapUiSizeCompact" icon="{= ${JM_ImageModel>/path} + 'Apply.svg'}" press="onokselect"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>