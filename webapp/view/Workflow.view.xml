<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="WF_RLS.controller.Workflow"
	xmlns:uitable="sap.ui.table" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:grid="sap.ui.layout">
	<App id="app">
		<pages>
			<Page enableScrolling="true" class=" sapUiSizeCompact cl_pageBg " showHeader="false">
				<content>
				<!--<customHeader>-->
					<OverflowToolbar height="2.5rem" class="cl_header_toolbar">
					
						<Image src="{= ${JM_ImageModel>/path} + 'Navback.svg'}" tooltip="{i18n>navBack}" width="1.2rem" press="fnNavBack" class="cl_ImageStyle"/>
						<Title text="{i18n>WorkFlowHdr}" class="sapUiTinyMarginBegin cl_header_title"/>
						<ToolbarSpacer/>
						<Label text="{UserModel>/id} - {UserModel>/Uname}" class="cl_userid_font sapUiTinyMarginEnd"/>
						<Image src="{= ${JM_ImageModel>/path} + 'ExalcaLogotiny.svg'}" tooltip="{i18n>ExalcaMDS}" class="sapUiSmallMarginEnd" width="1rem"></Image>
					</OverflowToolbar>
				<!--</customHeader>-->
				
					<!--<core:Fragment fragmentName="WF_RLS.Fragment.NavigationBar" type="XML"/>-->
					<VBox class=" sapUiSmallMarginEnd sapUiTinyMarginTop">
						<grid:Grid id="idMainGrid" hSpacing="0" defaultSpan="L12 M12 S12" class="sapUiTinyMarginBottom">
							<VBox class="sapUiSmallMarginBegin sapUiTinyMarginTop">
								<Label id="WID_APPID_TXT" text="{i18n>ApplicationId}" required="true" class="cl_inputLabel"/>
								<Input id="WID_APPID" class="cl_InputField" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="fnF4press"/>
								<layoutData>
									<grid:GridData span="L2 M12 S12"/>
								</layoutData>
							</VBox>
							<VBox alignItems="End" id="idEmptySpaceVBox">
								<Label/>
								<HBox>
									<Button id="id_search" text="{i18n>Search}" icon="{= ${JM_ImageModel>/path} + 'Search.svg'}"
										class="cl_PrimaryButton sapUiSizeCompact sapUiTinyMarginEnd" press="fnSearchGD" tooltip="{i18n>Search}"/>
									<Button id="id_saveWf" text="{i18n>Save}" enabled="false" icon="{= ${JM_ImageModel>/path} + 'Save.svg'}"
										class="cl_PrimaryButton sapUiSizeCompact sapUiTinyMarginEnd" press="fnSaveWorkflow" tooltip="{i18n>Save}"/>
									<Button id="id_ChngeSrch" enabled="false" icon="{= ${JM_ImageModel>/path} + 'Changesearch.svg'}"
										class="cl_NoTxtSecondaryBtn sapUiSizeCompact sapUiTinyMarginEnd" press="fnChangeSearch" tooltip="{i18n>ChangeSearch}"/>
									<Button id="id_forAgent" icon="{= ${JM_ImageModel>/path} + 'forward.svg'}" class="cl_NoTxtSecondaryBtn sapUiSizeCompact sapUiTinyMarginEnd"
										press="fnforward" tooltip="{i18n>WorkflowDelegation}"/>
									<Button id="id_ApplicationSla" enabled="false" icon="{= ${JM_ImageModel>/path} + 'SLAMail.svg'}"
										class="cl_NoTxtSecondaryBtn sapUiSizeCompact sapUiTinyMarginEnd" press="fnApplicationSla" tooltip="{i18n>ApplicationSLA}"/>
									<Button id="id_CreateVar" enabled="false" icon="{= ${JM_ImageModel>/path} + 'createvar.svg'}"
										class="cl_NoTxtSecondaryBtn sapUiSizeCompact sapUiTinyMarginEnd" press="fnGetCreateVar" tooltip="{i18n>CreateVariant}"/>
									<Button id="id_Masschange" icon="{= ${JM_ImageModel>/path} + 'agent.svg'}" class="cl_NoTxtSecondaryBtn sapUiSizeCompact"
										press="fnPressAgentChange" tooltip="{i18n>MAC}"/>
								</HBox>
								<layoutData>
									<grid:GridData span="L10 M12 S12"/>
								</layoutData>
							</VBox>
						</grid:Grid>
						<grid:Grid hSpacing="0" vSpacing="1" defaultSpan="L12 M12 S12" class="sapUiSmallMarginBegin ">
							<VBox class="cl_search_grid sapUiTinyMarginEnd">
								<OverflowToolbar class="cl_CharOverflow_toolbar sapUiSmallMarginBegin ">
									<Text text="{i18n>GD}" class="cl_headerlabel"/>
									<ToolbarSpacer/>
									<Image id="AddImage" src="{= ${JM_ImageModel>/path} + 'icon11.svg'}" width="1.1rem" class="cl_AddDelete cl_ImageStyle" press=".onAddGDRow"
										tooltip="{i18n>AddGeneralData}"/>
									<Image id="DelImage" src="{= ${JM_ImageModel>/path} + 'minus1.svg'}" width="1.1rem" class="cl_AddDelete cl_ImageStyle sapUiTinyMarginEnd"
										press=".ondelete" tooltip="{i18n>DeleteGeneralData}"/>
								</OverflowToolbar>
								<OverflowToolbar class="cl_CharOverflow_toolbar sapUiSmallMarginBegin sapUiTinyMarginBottom">
									<Button id="id_Mass" text="{i18n>Mass Copy}" icon="{= ${JM_ImageModel>/path} + 'Mass.svg'}" class="cl_MassBtn sapUiSizeCompact " enabled="false"
										press="fnMassCopy" tooltip="{i18n>MC}"/>
									<Button id="id_massdel" icon="{= ${JM_ImageModel>/path} + 'DeleteRule.svg'}" text="{i18n>Mass Delete}" enabled="false" press="fn_MassDelete"
										class="cl_MassBtn sapUiSizeCompact " tooltip="{i18n>MassDelete}"/>
									<Button id="id_Copy" text="{i18n>Copy}" icon="{= ${JM_ImageModel>/path} + 'CopyRule.svg'}" class="cl_MassBtn sapUiSizeCompact "
										press="fnSingleCopy" enabled="false" tooltip="{i18n>SC}"/>
									<Button id="id_generalSla" text="{i18n>SLA}" icon="{= ${JM_ImageModel>/path} + 'Email.svg'}" class="cl_MassBtn sapUiSizeCompact "
										press="fnGeneralSla" tooltip="{i18n>GeneralSLA}" enabled="false"/>
									<Button id="id_change" text="{i18n>Change}" icon="{= ${JM_ImageModel>/path} + 'ref.svg'}" class="cl_MassBtn sapUiSizeCompact "
										press="fnChange" tooltip="{i18n>Chge}" enabled="false"/>
								</OverflowToolbar>
								<uitable:Table id="id_ResultTable" rows="{GDTableModel>/GDTableData}" selectionMode="Single" enableSelectAll="true" selectionBehavior="Row"
									class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom cl_TableStyle " rowSelectionChange="fnRowSelectionChange" visibleRowCountMode="Fixed"
									visibleRowCount="10">
									<uitable:noData>
										<VBox alignItems="Center" justifyContent="Center">
											<Image src="{= ${JM_ImageModel>/path} + 'Nodatafound.gif'}" width="150px" height="150px"/>
											<!--<Image src="{= ${JM_ImageModel>/path} + 'NoDataFound.png'}" width="130px" height="130px"/>-->
											<Text text="{i18n>NoDataFound}"/>
										</VBox>
									</uitable:noData>
									<uitable:columns>
										<uitable:Column >
											<Label/>
											<uitable:template>
												<VBox/>
											</uitable:template>
										</uitable:Column>
									</uitable:columns>
								</uitable:Table>
								<layoutData>
									<grid:GridData span="L4 M12 S12"/>
								</layoutData>
							</VBox>
							<VBox height="100%">
								<VBox class="cl_search_grid sapUiSmallMarginBottom">
									<OverflowToolbar class="cl_CharOverflow_toolbar sapUiSmallMarginBegin ">
										<Text text="{i18n>LevelDefinition}" class="cl_headerlabel"/>
										<ToolbarSpacer/>
										<Image id="AddImage1" src="{= ${JM_ImageModel>/path} + 'icon11.svg'}" width="1.1rem" class="cl_AddDelete cl_ImageStyle " press="fnAddLDRow"
											tooltip="{i18n>AddLevel}"/>
										<Image id="DelImage1" src="{= ${JM_ImageModel>/path} + 'minus1.svg'}" width="1.1rem" class="cl_AddDelete cl_ImageStyle sapUiTinyMarginEnd"
											press="fndeleteLD" tooltip="{i18n>RemoveLevel}"/>
									</OverflowToolbar>
									<uitable:Table id="id_LDTable" rows="{LDTableModel>/tableDataNew}" selectionMode="Single" enableSelectAll="true" ariaLabelledBy="tableTitle"
										visibleRowCount="4" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom cl_TableStyle" rowSelectionChange="fnLDRowSelectionChange"
										rowHeight="32" visibleRowCountMode="Fixed">
										<uitable:noData>
											<VBox alignItems="Center" justifyContent="Center">
												<Image src="{= ${JM_ImageModel>/path} + 'Nodatafound.gif'}" width="100px" height="100px"/>
												<!--<Image src="{= ${JM_ImageModel>/path} + 'NoDataFound.png'}" width="100px" height="100px"/>-->
												<Text text="{i18n>NoDataFound}"/>
											</VBox>
										</uitable:noData>
										<uitable:columns>
											<uitable:Column >
												<Label text="{i18n>Level}" tooltip="{i18n>Level}"/>
												<uitable:template>
													<VBox >
														<Text text="{LDTableModel>Lvl}" tooltip="{LDTableModel>Lvl}" class="cl_TableLabel sapUiTinyMarginBegin"/>
													</VBox>
												</uitable:template>
											</uitable:Column>
											<uitable:Column>
												<Label text="{i18n>Area}" tooltip="{i18n>Area}"/>
												<uitable:template>
													<HBox alignItems="Center" justifyContent="SpaceBetween">
														<Label text="{LDTableModel>TypeLvl}" tooltip="{LDTableModel>TypeLvl}" class="cl_TableLabel sapUiTinyMarginBegin"
															visible="{= !${viewModel>/isComboEditable} || ${LDTableModel>TypeLvl} === 'Initiator' }"/>
														<ComboBox items="{ path: 'JAreaModel>/List', templateShareable: false }" selectedKey="{LDTableModel>TypeLvl}" change="onTypeLvlComboChange"
															editable="{LDTableModel>isTypeEditable}" visible="{= ${viewModel>/isComboEditable} &amp;&amp; ${LDTableModel>TypeLvl} !== 'Initiator'}"
															class="sapUiSizeCompact cl_TableInput " tooltip="{LDTableModel>TypeLvl}">
															<core:Item key="{JAreaModel>DomvalueL}" text="{JAreaModel>Ddtext}"/>
														</ComboBox>
													</HBox>
												</uitable:template>
											</uitable:Column>
											<uitable:Column class="cl_maxField">
												<Label text="{i18n>MaxNoRole}" tooltip="{i18n>MaxNoRole}"/>
												<uitable:template class="cl_maxField">
													<Text text="{path: 'LDTableModel>MaxRole', formatter: '.removeLeadingZeros'}"
														tooltip="{path: 'LDTableModel>MaxRole', formatter: '.removeLeadingZeros'}" class="cl_TableLabel sapUiTinyMarginBegin"/>
												</uitable:template>
											</uitable:Column>
											<uitable:Column >
												<Label text="{i18n>MinNoRole}" tooltip="{i18n>MinNoRole}"/>
												<uitable:template>
													<Input value="{path: 'LDTableModel>MinAppr', formatter: '.removeLeadingZeros'}"
														tooltip="{path: 'LDTableModel>MinAppr', formatter: '.removeLeadingZeros'}"
														editable="{= ${LDTableModel>Type} === 'Sequential' ? false : (${viewModel>/isEditable} &amp;&amp; ${LDTableModel>isRowEditable}) }"
														liveChange=".onMinApprLiveChange" class="cl_TableInput"/>
												</uitable:template>
											</uitable:Column>
											<uitable:Column width="12%">
												<Label text="{i18n>Department}" tooltip="{i18n>Department}"/>
												<uitable:template>
													<HBox alignItems="Center" justifyContent="SpaceBetween" class="">
														<ComboBox items="{ path: 'DeptModel>/Departments', templateShareable: false }" selectedKey="{LDTableModel>Dept}"
															tooltip="{LDTableModel>Dept}" change="onDeptChange" editable="{= ${viewModel>/isEditable} &amp;&amp; ${LDTableModel>isTypeEditable} }"
															class="sapUiSizeCompact cl_TableInput ">
															<core:Item key="{DeptModel>key}" text="{DeptModel>text}"/>
														</ComboBox>
													</HBox>
												</uitable:template>
											</uitable:Column>
											<uitable:Column >
												<Label text="{i18n>Type}" tooltip="{i18n>Type}"/>
												<uitable:template>
													<HBox alignItems="Center" justifyContent="SpaceBetween" class="">
														<ComboBox items="{ path: 'JAppID>/List', templateShareable: false }" selectedKey="{LDTableModel>Type}" tooltip="{LDTableModel>Type}"
															change="onLDTypeChange" editable="{= ${viewModel>/isEditable} &amp;&amp; ${LDTableModel>isRowEditable} }"
															class="sapUiSizeCompact cl_TableInput ">
															<core:Item key="{JAppID>DomvalueL}" text="{JAppID>Ddtext}"/>
														</ComboBox>
													</HBox>
												</uitable:template>
											</uitable:Column>
											<uitable:Column hAlign="Center">
												<Label text="{i18n>EmailSLA}" tooltip="{i18n>EmailSLA}"/>
												<uitable:template>
													<VBox class="cl_MiniMarginTop">
														<Image src="{= ${JM_ImageModel>/path} + 'Email.svg'}" width="1.15rem" press="fnOpenEmailSLA" tooltip="{i18n>Add_DeleteEmail}"
															class="cl_ImageStyle sapUiTinyMarginEnd"/>
													</VBox>
												</uitable:template>
											</uitable:Column>
											<uitable:Column class="cl_maxField">
												<Label text="{i18n>RemDays}" tooltip="{i18n>RemDays}"/>
												<uitable:template class="cl_maxField">
													<Label text="{ parts: [ {path: 'LDTableModel>RemWfDays'}, {path: 'LDTableModel>RemWfHour'} ], formatter: '.fnformatSLADays' }"
														tooltip="{ parts: [ {path: 'LDTableModel>RemWfDays'}, {path: 'LDTableModel>RemWfHour'} ], formatter: '.fnformatSLADays' }"
														class="cl_TableLabel sapUiTinyMarginBegin"/>
												</uitable:template>
											</uitable:Column>
											<uitable:Column class="cl_maxField">
												<Label text="{i18n>EscDays}" tooltip="{i18n>EscDays}"/>
												<uitable:template class="cl_maxField">
													<Label text="{ parts: [ {path: 'LDTableModel>EscWfDays'}, {path: 'LDTableModel>EscWfHour'} ], formatter: '.fnformatSLADays' }"
														tooltip="{ parts: [ {path: 'LDTableModel>EscWfDays'}, {path: 'LDTableModel>EscWfHour'} ], formatter: '.fnformatSLADays' }"
														class="cl_TableLabel sapUiTinyMarginBegin"/>
												</uitable:template>
											</uitable:Column>
										</uitable:columns>
									</uitable:Table>
								</VBox>
								<VBox class="cl_search_grid ">
									<OverflowToolbar class="cl_CharOverflow_toolbar sapUiSmallMarginBegin ">
										<Text text="{i18n>AgentAssignment}" class="cl_headerlabel"/>
										<ToolbarSpacer/>
										<Image id="AddImage2" src="{= ${JM_ImageModel>/path} + 'icon11.svg'}" width="1.1rem" class="cl_AddDelete cl_ImageStyle " press=".onAddAARow"
											tooltip="{i18n>AddAgentDetails}"/>
										<Image id="DelImage2" src="{= ${JM_ImageModel>/path} + 'minus1.svg'}" width="1.1rem" class="cl_AddDelete cl_ImageStyle sapUiTinyMarginEnd"
											press=".ondeleteAA" tooltip="{i18n>RemoveAgentDetails}"/>
									</OverflowToolbar>
									<uitable:Table id="id_Agent" rows="{AATableModel>/tableDataAA}" selectionMode="Single" enableSelectAll="true" ariaLabelledBy="tableTitle"
										visibleRowCount="4" rowSelectionChange="onAASelectionChange" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom cl_TableStyle">
										<uitable:noData>
											<VBox alignItems="Center" justifyContent="Center">
												<Image src="{= ${JM_ImageModel>/path} + 'Nodatafound.gif'}" width="100px" height="100px"/>
												<!--<Image src="{= ${JM_ImageModel>/path} + 'NoDataFound.png'}" width="100px" height="100px"/>-->
												<Text text="{i18n>NoDataFound}"/>
											</VBox>
										</uitable:noData>
										<uitable:columns>
											<uitable:Column>
												<Label text="{i18n>Active}" tooltip="{i18n>Active}"/>
												<uitable:template>
													<HBox>
														<CheckBox class="cl_checkbx sapUiSizeCompact sapUiTinyMarginBegin" selected="{AATableModel>Active}"
															editable="{= ${viewModel>/isEditable} &amp;&amp; ${AATableModel>isRowEditable} }" select="onActiveSelect"></CheckBox>
													</HBox>
												</uitable:template>
											</uitable:Column>
											<uitable:Column >
												<Label text="{i18n>StartDate}" tooltip="{i18n>StartDate}"/>
												<uitable:template>
													<VBox class="cl_sttabInput ">
														<DatePicker editable="false"
															value="{path: 'AATableModel>StartDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy', strictParsing: true }}"
															displayFormat="dd.MM.yyyy" valueFormat="dd.MM.yyyy" class="cl_TableInput"/>
													</VBox>
												</uitable:template>
											</uitable:Column>
											<uitable:Column>
												<Label text="{i18n>EndDate}" tooltip="{i18n>EndDate}"/>
												<uitable:template>
													<DatePicker editable="{= ${viewModel>/isEditable} &amp;&amp; ${AATableModel>Lvl} !== 'L0' }"
														value="{path: 'AATableModel>EndDate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'dd.MM.yyyy', strictParsing: true }}"
														displayFormat="dd.MM.yyyy" valueFormat="dd.MM.yyyy" class="cl_TableInput" change="onEndDateChange"/>
												</uitable:template>
											</uitable:Column>
											<uitable:Column>
												<Label text="{i18n>Agent}" tooltip="{i18n>Agent}"/>
												<uitable:template>
													<Input value="{AATableModel>Agent}" tooltip="{AATableModel>Agent}"
														editable="{= ${viewModel>/isEditable} &amp;&amp; ${AATableModel>LvlFromLD} !== 'L0' }" class=" cl_TableInput" showValueHelp="true"
														valueHelpRequest="fngetAgents" valueHelpOnly="true"/>
												</uitable:template>
											</uitable:Column>
											<uitable:Column>
												<Label text="{i18n>Name}" tooltip="{i18n>Name}"/>
												<uitable:template>
													<Label text="{AATableModel>Name}" tooltip="{AATableModel>Name}" class="cl_TableLabel sapUiTinyMarginBegin"/>
												</uitable:template>
											</uitable:Column>
											<uitable:Column>
												<Label text="{i18n>Variant}" tooltip="{i18n>Variant}"/>
												<uitable:template>
													<Input value="{AATableModel>Variant}" tooltip="{AATableModel>Variant}" editable="{= ${viewModel>/isEditable} }"
														valueHelpRequest="onVariantOpen" showValueHelp="true" valueHelpOnly="true" class=" cl_TableInput"/>
												</uitable:template>
											</uitable:Column>
											<uitable:Column>
												<Label text="{i18n>WFDel}" tooltip="{i18n>DelidationIndicator}"/>
												<uitable:template>
													<Input value="{AATableModel>DeliInd}" tooltip="{AATableModel>Delidation Ind}" editable="{= ${viewModel>/isEditable} }"
														class=" cl_TableInput"/>
												</uitable:template>
											</uitable:Column>
										</uitable:columns>
									</uitable:Table>
								</VBox>
								<layoutData>
									<grid:GridData span="L8 M12 S12"/>
								</layoutData>
							</VBox>
						</grid:Grid>
					</VBox>
				</content>
			</Page>
		</pages>
	</App>
</mvc:View>