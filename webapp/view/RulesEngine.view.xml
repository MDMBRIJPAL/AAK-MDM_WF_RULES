<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="WF_RLS.controller.RulesEngine"
	xmlns:uitable="sap.ui.table" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:grid="sap.ui.layout">
	<App>
		<pages>
			<Page class="sapUiSizeCompact cl_pageBg" enableScrolling="true" showHeader="false">
				<!--<customHeader>-->
				<content>
					<OverflowToolbar height="2.5rem" class=" cl_header_toolbar">
						<Image src="{= ${JM_ImageModel>/path} + 'Navback.svg'}" tooltip="{i18n>navBack}" width="1.2rem" press="fnNavBack"
							class="cl_ImageStyle sapUiTinyMarginBegin"/>
						<Title text="{i18n>RulesEngineHdr}" class="sapUiTinyMarginBegin cl_header_title"/>
						<ToolbarSpacer/>
						<Label text="{JM_User>/id} - {JM_User>/Uname}" class="cl_userid_font sapUiTinyMarginEnd"/>
						<Image src="{= ${JM_ImageModel>/path} + 'ExalcaLogotiny.svg'}" tooltip="{i18n>ExalcaMDS}" class="sapUiSmallMarginEnd" width="1rem"></Image>
					</OverflowToolbar>
				<!--</customHeader>-->
				
					<!--<core:Fragment fragmentName="WF_RLS.Fragment.NavigationBar" type="XML"/>-->
					<VBox class=" sapUiSmallMarginEnd sapUiSmallMarginTop">
						<grid:Grid class="sapUiSmallMarginBegin sapUiTinyMarginBottom cl_search_grid">
							<VBox class="sapUiTinyMarginTop">
								<Label text="{i18n>ApplicationID}" class="cl_inputLabel" labelFor="RID_MASTER"/>
								<VBox width="100%">
									<Input id="RID_MASTER" required="true" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="fnAppId" class="cl_InputField"/>
								</VBox>
								<layoutData>
									<grid:GridData span="L2 M12 S12"/>
								</layoutData>
							</VBox>
							<VBox class="sapUiTinyMarginTop">
								<Label text="{i18n>Screen}" class="cl_inputLabel" labelFor="id_Screen"/>
								<VBox width="100%">
									<Input id="id_Screen" class="cl_InputField " required="true" valueHelpRequest="fnGetScreens" showValueHelp="true" valueHelpOnly="true"/>
								</VBox>
								<layoutData>
									<grid:GridData span="L2 M12 S12"/>
								</layoutData>
							</VBox>
							<VBox class="sapUiTinyMarginTop">
								<Label/>
								<HBox width="100%">
									<Button text="{i18n>Screen}" icon="{= ${JM_ImageModel>/path} + 'Search.svg'}" press="fnGetRules"
										class="cl_PrimaryButton sapUiSmallMarginEnd"/>
									<Button text="{i18n>SpecificRule}" icon="{= ${JM_ImageModel>/path} + 'Specific.svg'}" press="fnSpecificRule" class="cl_SecondaryButton "/>
								</HBox>
								<layoutData>
									<grid:GridData span="L3 M12 S12"/>
								</layoutData>
							</VBox>
						</grid:Grid>
						<grid:Grid hSpacing="0" defaultSpan="L12 M12 S12" class="sapUiSmallMarginBegin sapUiTinyMarginTop sapUiSmallMarginBottom ">
							<VBox class=" sapUiTinyMarginEnd cl_search_grid ">
								<OverflowToolbar class="cl_ToolBarSpacer sapUiTinyMarginTopBottom sapUiSmallMarginBegin ">
									<Label text="{i18n>RuleSet}" class="cl_headerlabel"/>
									<ToolbarSpacer/>
									<Button text="{i18n>CreateRuleSet}" enabled="false" id="id_createruleset" icon="{= ${JM_ImageModel>/path} + 'CreateRule.svg'}"
										class="cl_blueBtn " press="fnAddRuleSet"/>
									<Button icon="{= ${JM_ImageModel>/path} + 'SaveRule.svg'}" enabled="false" id="id_saveruleset" tooltip="{i18n>SaveRule}"
										class=" cl_NoTxtblueBtn sapUiSizeCompact" press="fnSaveRuleSet"/>
									<Button icon="{= ${JM_ImageModel>/path} + 'DeleteRule.svg'}" enabled="false" id="id_deleteruleset" tooltip="{i18n>DeleteRule}"
										class="sapUiSmallMarginEnd cl_NoTxtblueBtn sapUiSizeCompact" press="fnRemoveRuleSet"/>
								</OverflowToolbar>
								<uitable:Table id="id_ruleTable" rows="{JM_Rules>/Rule}" selectionMode="Single" visibleRowCount="11" rowSelectionChange="fnRuleSetSelection"
									class=" cl_TableStyle sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
									<uitable:noData>
										<VBox alignItems="Center" justifyContent="Center">
											<Image src="{= ${JM_ImageModel>/path} + 'Nodatafound.gif'}" width="150px" height="150px"/>
											<!--<Image src="{= ${JM_ImageModel>/path} + 'NoDataFound.png'}" width="130px" height="130px"/>-->
											<Text text="{i18n>NoDataFound}"/>
										</VBox>
									</uitable:noData>
									<uitable:columns>
										<uitable:Column>
											<Label text="{i18n>RulesDescription}"/>
											<uitable:template>
												<Input value="{JM_Rules>FmmDes}" editable="{= ${JM_Rules>FmmDes} === '' ? true : false}" showValueHelp="true" valueHelpOnly="true"
													valueHelpRequest="fnGetRuleSet" class="cl_TableInput cl_TableLabel"/>
											</uitable:template>
										</uitable:Column>
									</uitable:columns>
								</uitable:Table>
								<layoutData>
									<grid:GridData span="L4 M12 S12"/>
								</layoutData>
							</VBox>
							<VBox class=" cl_search_grid">
								<OverflowToolbar class="cl_ToolBarSpacer sapUiTinyMarginTopBottom sapUiSmallMarginBegin ">
									<Label text="{i18n>RuleData}" class="cl_headerlabel"/>
									<ToolbarSpacer/>
									<Button text="{i18n>CreateMass}" icon="{= ${JM_ImageModel>/path} + 'Mass.svg'}" class="cl_blueBtn " press="fnMassRule"
										enabled="{JM_Enabled>/Mass}"/>
									<Button text="{i18n>CreateNewRule}" icon="{= ${JM_ImageModel>/path} + 'CreateRule.svg'}" class="cl_blueBtn " press="fnCreateNewRuleData"
										enabled="{JM_Enabled>/Create}"/>
									<Button text="{i18n>AddRow}" icon="{= ${JM_ImageModel>/path} + 'CreateRule.svg'}" class="cl_blueBtn " press="fnAddRow"
										enabled="{JM_Enabled>/Add}"/>
									<Button text="{i18n>RemoveRow}" icon="{= ${JM_ImageModel>/path} + 'DeleteRule.svg'}" class="cl_blueBtn " press="fnRemoveRow"
										enabled="{JM_Enabled>/Remove}"/>
									<Button icon="{= ${JM_ImageModel>/path} + 'CopyRulesData.svg'}" tooltip="{i18n>CopyRuleData}" class=" cl_NoTxtblueBtn "
										press="fnCopyRuleData" enabled="{JM_Enabled>/Copy}"/>
									<Button icon="{= ${JM_ImageModel>/path} + 'SaveRule.svg'}" tooltip="{i18n>SaveRuleData}" class=" cl_NoTxtblueBtn sapUiSizeCompact"
										press="fnRuleDataSave" enabled="{JM_Enabled>/Save}"/>
									<Button icon="{= ${JM_ImageModel>/path} + 'DeleteRule.svg'}" tooltip="{i18n>DeleteRuleData}" class=" cl_NoTxtblueBtn sapUiSizeCompact"
										press="fnRemoveRuleData" enabled="{JM_Enabled>/Delete}"/>
									<Button icon="{= ${JM_ImageModel>/path} + 'RefreshRule.svg'}" tooltip="{i18n>RefreshRuleData}"
										class=" sapUiSmallMarginEnd cl_NoTxtblueBtn sapUiSizeCompact" press="fnRefresh" enabled="{JM_Enabled>/Refresh}"/>
								</OverflowToolbar>
								<uitable:TreeTable id="id_datatable" rows="{path:'JM_RuleData>/', parameters: {arrayNames:['Input']}}" selectionMode="Single"
									visibleRowCount="11" class="cl_TableStyle sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" toggleOpenState="fnExpandNode">
									<uitable:noData>
										<VBox alignItems="Center" justifyContent="Center">
											<Image src="{= ${JM_ImageModel>/path} + 'Nodatafound.gif'}" width="150px" height="150px"/>
											<!--<Image src="{= ${JM_ImageModel>/path} + 'NoDataFound.png'}" width="130px" height="130px"/>-->
											<Text text="{i18n>NoDataFound}"/>
										</VBox>
									</uitable:noData>
									<uitable:columns>
										<uitable:Column>
											<Label text="{i18n>RuleId}"/>
											<uitable:template>
												<Text text="{JM_RuleData>RuleId}" visible="{= ${JM_RuleData>Ftype} === 'I' ? false : true}" class="cl_TableLabel"/>
											</uitable:template>
										</uitable:Column>
										<uitable:Column>
											<Label text="{i18n>FieldName}"/>
											<uitable:template>
												<Input value="{JM_RuleData>Fnm}" tooltip="{JM_RuleData>Fnm}" valueHelpRequest="fnfieldname" showValueHelp="true" valueHelpOnly="true"
													editable="{= ${JM_RuleData>Ftype} === 'I' ? true : false}" class="cl_TableInput"/>
											</uitable:template>
										</uitable:Column>
										<uitable:Column width="10rem">
											<Label text="{i18n>FieldDescription}"/>
											<uitable:template>
												<Text text="{JM_RuleData>FmmDes}" tooltip="{JM_RuleData>FmmDes}" wrapping="false" class="sapUiTinyMarginBegin cl_TableLabel"/>
											</uitable:template>
										</uitable:Column>
										<uitable:Column>
											<Label text="{i18n>Value}"/>
											<uitable:template>
												<Input value="{JM_RuleData>Value}" tooltip="{JM_RuleData>Value}" valueState="{JM_RuleData>Value_VS}"
													valueStateText="{JM_RuleData>Value_VST}" id="id_value" valueHelpRequest="fnvalue" liveChange="fnUpperCase"
													showValueHelp="{parts: [{path: 'JM_RuleData>FnmId'}], formatter:'.formatter.fnShowValueHelp'}" valueHelpOnly="true" class="cl_TableInput"/>
											</uitable:template>
										</uitable:Column>
										<uitable:Column>
											<Label text="{i18n>Text}"/>
											<uitable:template>
												<Text text="{JM_RuleData>RuleText}" wrapping="false" class="sapUiTinyMarginBegin cl_TableLabel"/>
											</uitable:template>
										</uitable:Column>
										<uitable:Column id="id_tableui" visible="true">
											<Label text="{i18n>TableRow}"/>
											<uitable:template>
												<Input value="{JM_RuleData>TableRow}" tooltip="{JM_RuleData>TableRow}" editable="false" class="cl_TableInput"/>
											</uitable:template>
										</uitable:Column>
										<uitable:Column>
											<Label text="{i18n>FunctionType}"/>
											<uitable:template>
												<Text text="{path: 'JM_RuleData>Ftype', formatter:'.formatter.formatFtype'}" class="cl_TableLabel sapUiTinyMarginBegin"/>
											</uitable:template>
										</uitable:Column>
										<uitable:Column>
											<Label text="{i18n>ReadOnly}"/>
											<uitable:template>
												<CheckBox class="cl_checkbx" select="fnReadOnlySelect" selected="{JM_RuleData>ChangeInd}"
													enabled="{= ${JM_RuleData>Ftype} === 'R' ? true : false}" visible="{= ${JM_RuleData>Ftype} === 'R' ? true : false}"/>
											</uitable:template>
										</uitable:Column>
									</uitable:columns>
								</uitable:TreeTable>
								<layoutData>
									<grid:GridData span="L8 M12 S12"/>
								</layoutData>
							</VBox>
						</grid:Grid>
					</VBox>
				</content>
			</Page>
		</pages>
	</App>
</mvc:View>